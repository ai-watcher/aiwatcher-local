# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/

# Virtual environments
.venv/
venv/
env/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Local export artifacts. No prompt text or source, but they do carry local
# paths, project names, session ids and usage history -- the same things the
# docs refuse to put in a screenshot. `export` writes wherever it is pointed,
# so match the shapes people actually use, not just the two names in the docs.
aiwatcher-*.json
events.json
*-events.json
*-export.json

# Editor / OS
.vscode/
.idea/
.DS_Store

# Environment
.env
.env.*

# Second Opinion runs the analyst here, inside the project so the path is
# stable and reviewable. It holds a throwaway agent's scratch space, never
# anything worth committing.
.aiwatcher/

# Per-developer dev-server config for the Claude Code browser preview.
# Generated locally and full of machine-specific ports and absolute paths.
.claude/launch.json

# Throwaway UI spikes and the notes around them: mockups of proposed surfaces,
# captured API fixtures, and handoff prompts. Kept in the repo so they are where
# you would look for them and so their paths stay relative, but never shipped --
# a mockup that gets reviewed as product code is worse than no mockup, and the
# fixtures carry real local paths, session ids and dollar figures.
spike/
