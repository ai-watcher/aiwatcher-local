# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/

# Virtual environments
.venv/
venv/
env/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Local export artifacts. No prompt text or source, but they do carry local
# paths, project names, session ids and usage history -- the same things the
# docs refuse to put in a screenshot. `export` writes wherever it is pointed,
# so match the shapes people actually use, not just the two names in the docs.
aiwatcher-*.json
events.json
*-events.json
*-export.json

# Editor / OS
.vscode/
.idea/
.DS_Store

# Environment
.env
.env.*
